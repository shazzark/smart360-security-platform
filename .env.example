# Replace placeholders with your local WAMP MySQL credentials and database.
# URL-encode special characters in the username and password.
DATABASE_URL="mysql://YOUR_USER:YOUR_PASSWORD@localhost:3306/YOUR_DATABASE"

# Set the real public origin before the production build (no path or trailing query).
# Leave unset locally to prevent indexing; local sitemap URLs default to localhost.
SITE_URL=""
# Production example: SITE_URL="https://your-domain.example"

# Generate a unique random secret (at least 64 characters); never commit the real value.
SESSION_SECRET="REPLACE_WITH_A_CRYPTOGRAPHICALLY_RANDOM_64_CHARACTER_SECRET"
# Enable only behind a trusted proxy that overwrites X-Real-IP and blocks direct access.
# Without this, verification uses one shared five-per-minute bucket (safe local default).
VERIFY_TRUST_PROXY=false

# Server-only Cloudinary credentials. Never prefix these with NEXT_PUBLIC_.
CLOUDINARY_CLOUD_NAME="YOUR_CLOUD_NAME"
CLOUDINARY_API_KEY="YOUR_API_KEY"
CLOUDINARY_API_SECRET="YOUR_API_SECRET"

# One-time admin provisioning only; supply through protected environment configuration.
# ADMIN_EMAIL="your-admin@example.invalid"
# ADMIN_NAME="Administrator name"
# ADMIN_PASSWORD="" # Unique generated password, 16–1024 characters. Remove after provisioning.
